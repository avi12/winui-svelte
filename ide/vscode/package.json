{
  "name": "winui-svelte-vscode",
  "displayName": "winui-svelte",
  "description": "Previews and completes winui-svelte's Fluent icons, colors and installed fonts in .svelte files, and turns a component's props into the CSS that sets the same value",
  "version": "0.0.1",
  "publisher": "avi12",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "homepage": "https://github.com/avi12/winui-svelte/tree/main/ide/vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/avi12/winui-svelte.git",
    "directory": "ide/vscode"
  },
  "bugs": {
    "url": "https://github.com/avi12/winui-svelte/issues"
  },
  "galleryBanner": {
    "color": "#0a3d91",
    "theme": "dark"
  },
  "keywords": [
    "svelte",
    "winui",
    "fluent",
    "windows",
    "icon",
    "glyph",
    "color",
    "font",
    "css",
    "tauri"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:svelte"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "winuiSvelte.convertFile",
        "title": "Convert winui-svelte Attributes to CSS in This File"
      },
      {
        "command": "winuiSvelte.convertSelection",
        "title": "Convert winui-svelte Attributes to CSS"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "winuiSvelte.convertFile",
          "when": "resourceLangId == svelte",
          "group": "winuiSvelte"
        }
      ],
      "explorer/context": [
        {
          "command": "winuiSvelte.convertSelection",
          "when": "explorerResourceIsFolder || resourceExtname == .svelte",
          "group": "winuiSvelte"
        }
      ]
    },
    "keybindings": [
      {
        "command": "winuiSvelte.convertFile",
        "key": "ctrl+alt+shift+k",
        "when": "editorTextFocus && resourceLangId == svelte"
      },
      {
        "command": "winuiSvelte.convertSelection",
        "key": "ctrl+alt+shift+x",
        "when": "filesExplorerFocus && !inputFocus"
      }
    ],
    "configuration": {
      "title": "winui-svelte",
      "properties": {
        "winuiSvelte.destination": {
          "type": "string",
          "enum": [
            "styleBlock",
            "styleDirective"
          ],
          "enumDescriptions": [
            "Move a converted prop to a rule in the <style> block, with a class on the tag",
            "Write a converted prop as a style: directive on the tag"
          ],
          "default": "styleBlock",
          "description": "Where a prop that has a CSS counterpart goes when it is converted"
        }
      }
    }
  }
}
