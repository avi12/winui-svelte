      "data": "data:image/",
      "remote": [
        "https://",
        "http://"
      ],
      "file": "file:///"
    },
    "limits": {
      "maxFileBytes": 2097152,
      "inlineSize": 16,
      "hoverSize": 96
    },
    "remote": {
      "maxBytes": 2097152,
      "timeoutMillis": 5000,
      "maxAgeHours": 24,
      "cacheFolder": "winui-svelte-pictures",
      "maxRedirects": 3,
      "failureRetryMinutes": 5,
      "maxConcurrent": 2,
      "maxUrlLength": 2048
    },
    "backgrounds": {
      "light": "#f3f3f3",
      "dark": "#202020"
    },
    "signatures": [
