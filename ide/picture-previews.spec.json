          {
            "value": "on.ico",
            "variant": "any",
            "text": "onIcon"
          },
          {
            "value": "off.ico",
            "variant": "any"
          }
        ]
      },
      {
        "kind": "expression",
        "attribute": "icon",
        "text": "{{ forLightTaskbar: light, forDarkTaskbar: dark }}",
        "bindings": {
          "light": "l.ico",
          "dark": "d.ico"
