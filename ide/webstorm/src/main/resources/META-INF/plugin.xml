<idea-plugin>
  <id>dev.winui.svelte</id>
  <name>winui-svelte</name>
  <vendor url="https://github.com/avi12/winui-svelte">Avi</vendor>
  <description><![CDATA[
    An optional companion for projects that use
    <a href="https://github.com/avi12/winui-svelte">winui-svelte</a>, the WinUI 3 controls as Svelte components for
    native Windows apps; it does nothing in a project that does not depend on it.
    <ul>
      <li><b>Icons</b>: a Fluent icon name in a <code>glyph</code> prop, or in any prop typed
        <code>GlyphInput</code>, shows the icon inside the string, in the documentation popup and in completion</li>
      <li><b>Colors</b>: a color in <code>style:color</code>, in <code>style="..."</code> or in a color prop shows
        a swatch beside it</li>
      <li><b>Fonts</b>: the font-family completion lists the installed fonts, each in its own face</li>
      <li><b>Convert to CSS</b>: Alt+Enter on a prop that has a CSS counterpart moves it into the
        <code>&lt;style&gt;</code> block or a <code>style:</code> directive; actions convert a whole file or the
        selected files and folders, and the class names it writes can be found and renamed</li>
    </ul>
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>JavaScript</depends>
  <depends>com.intellij.css</depends>
  <depends>dev.blachut.svelte.lang</depends>
  <extensions defaultExtensionNs="com.intellij">
    <localInspection
        language="SvelteHTML"
        shortName="WinuiPropCssCounterpart"
        displayName="winui-svelte prop that has a CSS counterpart"
        groupName="winui-svelte"
        level="INFO"
        enabledByDefault="true"
        implementationClass="dev.winui.svelte.CssCounterpartInspection"/>
    <intentionAction>
      <language>SvelteHTML</language>
      <className>dev.winui.svelte.ConvertAllInFileIntention</className>
      <category>winui-svelte</category>
    </intentionAction>
    <projectConfigurable
        parentId="editor"
        instance="dev.winui.svelte.SettingsConfigurable"
        id="winui.svelte.settings"
        displayName="winui-svelte"/>
    <psi.referenceContributor
        language="JavaScript"
        implementation="dev.winui.svelte.ComponentClassReferenceContributor"/>
    <psi.referenceContributor
        language="TypeScript"
        implementation="dev.winui.svelte.ComponentClassReferenceContributor"/>
    <lang.elementManipulator
        forClass="dev.blachut.svelte.lang.psi.SvelteHtmlAttribute"
        implementationClass="dev.winui.svelte.DirectiveNameManipulator"
        order="first"/>
    <css.classOrIdUsagesProvider implementation="dev.winui.svelte.ComponentClassUsagesProvider"/>
    <completion.contributor
        language="any"
        order="first"
        implementationClass="dev.winui.svelte.GlyphCompletionContributor"/>
    <lang.documentationProvider
        language="SvelteHTML"
        order="first"
        implementationClass="dev.winui.svelte.GlyphDocumentationProvider"/>
    <codeInsight.inlayProvider
        language="SvelteHTML"
        implementationClass="dev.winui.svelte.GlyphInlayProvider"/>
    <codeInsight.inlayProvider
        language="SvelteHTML"
        implementationClass="dev.winui.svelte.ColorInlayProvider"/>
    <completion.contributor
        language="any"
        order="first"
        implementationClass="dev.winui.svelte.FontFamilyCompletionContributor"/>
    <notificationGroup id="winui-svelte" displayType="BALLOON"/>
  </extensions>
  <actions>
    <action
        id="winui.svelte.ConvertFile"
        class="dev.winui.svelte.ConvertFileAction"
        text="Convert winui-svelte Attributes to CSS in This File"
        description="Writes every winui-svelte attribute of the open file that has a CSS counterpart as CSS">
      <keyboard-shortcut keymap="$default" first-keystroke="control alt shift K"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <action
        id="winui.svelte.ConvertSelection"
        class="dev.winui.svelte.ConvertSelectionAction"
        text="Convert winui-svelte Attributes to CSS"
        description="Writes the winui-svelte attributes of the selected Svelte files and folders as CSS">
      <keyboard-shortcut keymap="$default" first-keystroke="control alt shift X"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
    </action>
    <group id="winui.svelte.Group" text="winui-svelte" popup="true">
      <reference ref="winui.svelte.ConvertFile"/>
      <reference ref="winui.svelte.ConvertSelection"/>
      <add-to-group group-id="CodeMenu" anchor="last"/>
    </group>
  </actions>
</idea-plugin>
