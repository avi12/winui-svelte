    "examples/form/main.ts",
    "examples/accessibility/main.ts",
    "examples/fonts/main.ts",
    "examples/pill-ground/main.ts",
    "**/*.test.ts",
    "src/state/test-support/echo-host.ts",
    "test/mount-all.svelte.ts",
    "test/mount-all.ts",
    "test/mount-all.worker.ts",
    "scripts/codegen/generate.ts",
