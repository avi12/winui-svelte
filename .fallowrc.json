    "src/web-apis/wake-lock.ts",
    "src/web-apis/credentials.ts",
    "src/web-apis/eye-dropper.ts",
    "src/web-apis/contacts.ts",
    "src/web-apis/fonts.ts",
    "src/tray/index.ts",
    "src/tray/standalone/index.ts",
    "src/notice/index.ts",
    "scripts/pack/treeshake-app/tray-main.ts",
    "src/enums.ts",
    "test/choice-props.types.ts",
    "scripts/pack/treeshake-app/enum-main.ts",
    "scripts/pack/treeshake-app/five-main.ts",
    "src/forms/index.ts",
    "src/forms/Form.d.svelte.ts",
    "src/forms/FormField.d.svelte.ts",
    "src/settings/index.ts",
    "src/settings/SettingsCard.d.svelte.ts",
