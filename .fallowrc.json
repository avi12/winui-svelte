    "examples/hello/main.ts",
    "examples/dev-host/main.ts",
    "examples/dev-host/App.svelte",
    "src/dev/dev-window.ts",
    "examples/keys/main.ts",
    "examples/hotkeys/main.ts",
    "examples/win2d/main.ts",
    "examples/data-transfer/main.ts",
    "examples/effects/main.ts",
    "examples/scroll-timeline/main.ts",
    "test/scoped-styles/main.ts",
    "examples/stores/main.ts",
    "examples/timers/main.ts",
    "examples/loop/main.ts",
    "examples/hello/App.svelte",
    "src/components/index.ts",
    "examples/harness/launch.ts",
    "examples/harness/worker.ts",
    "examples/harness/run-example.ts",
    "examples/lists/main.ts",
    "examples/transitions/main.ts",
    "examples/chip-tray/main.ts",
    "examples/card-glide/main.ts",
    "examples/layout-animation/main.ts",
    "examples/refused-toggle/main.ts",
    "examples/settings-cards/main.ts",
    "examples/items/main.ts",
    "examples/interaction/main.ts",
    "examples/navigation/main.ts",
    "examples/tree/main.ts",
    "examples/overlays/main.ts",
    "examples/flyout-click/main.ts",
    "examples/services/main.ts",
    "examples/media/main.ts",
    "examples/media-elements/main.ts",
    "examples/app/main.ts",
    "examples/activation/main.ts",
    "examples/web/main.ts",
    "examples/web-bridge/main.ts",
    "examples/window/main.ts",
    "examples/window-frame/main.ts",
    "examples/window-swap/main.ts",
    "examples/tray/main.ts",
    "examples/taskbar/main.ts",
    "examples/gallery/main.ts",
    "examples/todo/main.ts",
    "examples/settings/main.ts",
    "eslint.config.js",
    "svelte.config.js"
  ],
  // The bindings are reached through the #winui/* import map, the linters run
  // from package.json scripts, and the editor check starts the Svelte language
  // server as a process.
  "ignoreDependencies": [
    "@winapp/bindings",
    "oxlint-tsgolint",
    "@sveltejs/package",
    "svelte-language-server",
    "publint",
    "@arethetypeswrong/cli",
    "@microsoft/dynwinrt-codegen",
    "postcss-html"
  ],
  // Generated from WinUI's metadata: 167 components that differ by their
  // property lists, and an app renders them, not the package.
  // Called on the in-memory link by the state tests, through a type fallow
  // does not follow. The WindowHandle methods are public API that an app calls
  // and the package itself does not; the DOM members are what Svelte's client
  // runtime reads off the tree's nodes (renderer/tree/dom.ts).
  "usedClassMembers": [
    "onchange",
    "addListener",
    "removeListener",
    "sendMalformed",
    "close",
    "minimize",
    "maximize",
    "bringToFront",
    "pickFile",
    "pickFiles",
    "pickFolder",
    "saveFile",
    "nodeType",
    "parentNode",
    "firstChild",
    "lastChild",
    "nextSibling",
    "cloneNode",
    "remove",
    "before",
    "append",
    "appendChild",
    "insertBefore",
    "removeChild",
    "textContent",
    "data",
    "nodeValue",
    "namespaceURI",
    "nodeName",
    "className",
    "classList",
    "style",
    "getAttribute",
    "hasAttribute",
    "removeAttribute",
    "addEventListener",
    "removeEventListener",
    "focus",
    "value",
    // The Web API classes mirror the spec for a library written for a browser, which calls
    // members the package itself never does.
    "relatedTarget",
    "preventDefault",
    "stopPropagation",
    "setFeedback",
    "setDragImage",
    "sendJson",
    "setShownInSwitchers",
    // What a stand-in for a WinRT DeviceInformation or DeviceWatcher has because
    // the interface it implements needs it (src/devices/test-support).
    "pairing",
    "properties",
    "update",
    "start",
    "stop",
    "onAdded",
    "onUpdated",
    "onRemoved",
    "onEnumerationCompleted",
    "onStopped"
  ],
  "ignoreExports": [
    {
      "file": "src/components/generated/**",
      "exports": ["*"]
    },
    // The hand-written components' declarations are what an app's types read.
    {
      "file": "src/{components/hand-written,win2d}/*.d.svelte.ts",
      "exports": ["*"]
    },
    {
      "file": "src/tray/*.d.svelte.ts",
      "exports": ["*"]
    }
  ],
  // The examples each stand on their own (an app copies one), and the state
  // tests' child-process host is the shape of the counter example's host.
  // ListView and GridView are one component over two controls: a Svelte
  // component cannot be generic over the control class it renders.
  "duplicates": {
    "ignore": [
      "src/components/generated/**",
      "src/components/hand-written/*View.svelte",
      "examples/**",
      "src/state/test-support/**"
    ]
  },
  "rules": {
    "unrendered-components": "off"
  },
  // No coverage is fed to fallow, so it scores CRAP as cyclomatic squared plus
  // cyclomatic and flags every function above 5; the cyclomatic and cognitive
  // limits do the work (the limit here lies above what 20 would score). The
  // generated link functions have one branch per property of a WinUI class.
  "health": {
    "maxCrap": 1000,
    "ignore": ["src/components/generated/**"]
  }
}
