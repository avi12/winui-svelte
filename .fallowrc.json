    "src/app/hotkeys/index.ts",
    "src/web-apis/index.ts",
    "src/web-apis/notification.ts",
    "src/web-apis/launch.ts",
    "src/web-apis/push.ts",
    "src/web-apis/badging.ts",
    "src/web-apis/screen.ts",
    "src/web-apis/sensors.ts",
    "src/web-apis/gamepad.ts",
    "src/web-apis/network.ts",
    "src/web-apis/battery.ts",
    "src/web-apis/geolocation.ts",
    "src/web-apis/web-storage.ts",
    "src/web-apis/storage.ts",
    "src/web-apis/file-system.ts",
    "src/web-apis/share.ts",
    "src/web-apis/clipboard.ts",
    "src/web-apis/page.ts",
    "test/page-window.ts",
