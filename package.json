{
  "name": "winui-svelte",
  "version": "0.0.0",
  "description": "WinUI 3 controls as Svelte components: native Windows apps in Svelte, for Tauri, Electron or Node",
  "keywords": [
    "svelte",
    "winui",
    "winui3",
    "windows",
    "native",
    "desktop",
    "windows-app-sdk",
    "tauri",
    "electron",
    "svelte5",
    "xaml",
    "winrt",
    "dynwinrt"
  ],
  "homepage": "https://github.com/avi12/winui-svelte#readme",
  "bugs": {
    "url": "https://github.com/avi12/winui-svelte/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi12/winui-svelte.git"
  },
  "license": "MIT",
  "author": "Avi Hanan",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "svelte": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "svelte": "./dist/state/index.js",
      "default": "./dist/state/index.js"
    },
    "./state/host": {
      "types": "./dist/state/host.d.ts",
      "default": "./dist/state/host.js"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.ts",
      "default": "./dist/messaging/index.js"
    },
    "./host": {
      "types": "./dist/renderer/host/host.d.ts",
      "svelte": "./dist/renderer/host/host.js",
      "default": "./dist/renderer/host/host.js"
    },
    "./keyed-list": {
      "types": "./dist/renderer/list/keyed-list.d.ts",
      "svelte": "./dist/renderer/list/keyed-list.js",
      "default": "./dist/renderer/list/keyed-list.js"
    },
    "./element-animation": {
      "types": "./dist/renderer/host/element-animation.d.ts",
      "svelte": "./dist/renderer/host/element-animation.js",
      "default": "./dist/renderer/host/element-animation.js"
    },
    "./css": {
      "types": "./dist/css/index.d.ts",
      "default": "./dist/css/index.js"
    },
    "./css/gradients": {
      "types": "./dist/css/gradients.d.ts",
      "default": "./dist/css/gradients.js"
    },
    "./css/focus": {
      "types": "./dist/css/focus.d.ts",
      "default": "./dist/css/focus.js"
    },
    "./css/resources": {
      "types": "./dist/css/resources.d.ts",
      "default": "./dist/css/resources.js"
    },
    "./css/surface": {
      "types": "./dist/css/surface.d.ts",
      "default": "./dist/css/surface.js"
    },
    "./css/transform": {
      "types": "./dist/css/transform.d.ts",
      "default": "./dist/css/transform.js"
    },
    "./css/vite": {
      "types": "./dist/css/vite.d.ts",
      "default": "./dist/css/vite.js"
    },
    "./css/sheet-module": {
      "types": "./dist/css/runtime/sheet-module.d.ts",
      "default": "./dist/css/runtime/sheet-module.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./runner": {
      "types": "./dist/vite/runner.d.ts",
      "default": "./dist/vite/runner.js"
    },
    "./compile": {
      "types": "./dist/vite/compile.d.ts",
      "default": "./dist/vite/compile.js"
    },
    "./testing": {
      "types": "./dist/vite/loader.d.ts",
      "default": "./dist/vite/loader.js"
    },
    "./bootstrap": {
      "types": "./dist/window/bootstrap.d.ts",
      "default": "./dist/window/bootstrap.js"
    },
    "./thread": {
      "types": "./dist/window/thread.d.ts",
      "default": "./dist/window/thread.js"
    },
    "./window": {
      "types": "./dist/window/index.d.ts",
      "svelte": "./dist/window/index.js",
      "default": "./dist/window/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#src/*.js": "./src/*.ts",
    "#src/*.svelte": "./src/*.svelte",
    "#src/*.json": "./src/*.json",
    "#scripts/*.ts": "./scripts/*.ts",
    "#examples/*.ts": "./examples/*.ts",
    "#winui/*": {
      "types": "./dist/bindings/*.d.ts",
      "default": "./dist/bindings/*.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/state/test-support",
    "!src/renderer/testing/fake-controls.ts",
    "!src/renderer/testing/tree-probe.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "restore": "winapp restore && pnpm bindings:after-winapp",
    "bindings": "winapp node generate-bindings && pnpm bindings:after-winapp",
    "bindings:after-winapp": "node --disable-warning=ExperimentalWarning scripts/bindings/after-winapp.ts",
    "build": "node --disable-warning=ExperimentalWarning scripts/pack/build.ts",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:editor": "node --disable-warning=ExperimentalWarning scripts/editor/check-editor.ts",
    "check:webstorm": "node --disable-warning=ExperimentalWarning scripts/editor/check-webstorm.ts",
    "check:package": "node --disable-warning=ExperimentalWarning scripts/pack/check-package.ts",
    "fallow": "fallow",
    "gen:components": "node --disable-warning=ExperimentalWarning scripts/codegen/generate.ts",
    "gen:components:check": "node --disable-warning=ExperimentalWarning scripts/codegen/generate.ts --check",
    "lint": "node --disable-warning=ExperimentalWarning scripts/lint/lint.ts",
    "lint:oxlint": "oxlint --type-aware",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"**/*.svelte\" --ignore-pattern src/components/generated",
    "lint:summary": "node --disable-warning=ExperimentalWarning scripts/lint/summary.ts",
    "test": "pnpm build && node --disable-warning=ExperimentalWarning --test --test-timeout=120000 \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" test/mount-all.test.ts",
    "test:windows": "pnpm build && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test-timeout=120000 test/lists.test.ts test/items.test.ts test/overlays.test.ts test/transitions.test.ts test/web.test.ts test/window.test.ts"
  },
  "dependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.23",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
